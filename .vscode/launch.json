{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false, //这里设置为false,才会进入库代码，默认为true
            "env": {
                // ${workspaceFolder} = VSCode打开的项目根目录
                // Windows用分号;分隔多路径，Mac/Linux用冒号:
                "PYTHONPATH": "${workspaceFolder};${env:PYTHONPATH}"
            }
        },
        {
            "name": "draft.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/draft/draft.py",
            "console": "integratedTerminal",
            "justMyCode": false, //这里设置为false,才会进入库代码，默认为true
            "env": {
                // ${workspaceFolder} = VSCode打开的项目根目录
                // Windows用分号;分隔多路径，Mac/Linux用冒号:
                "PYTHONPATH": "${workspaceFolder};${env:PYTHONPATH}"
            }
        },
        {
            "name": "pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                // 这里可以指定要运行的测试文件，比如 "tests/common/test_util.py"
                // 也可以留空，运行所有测试
                "-vv",
                "--md=./tests/test_report.md",
                "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "pytest-mtorch",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                // 这里可以指定要运行的测试文件，比如 "tests/common/test_util.py"
                // 也可以留空，运行所有测试
                // "./mtorch/tests/units/core/test_operators.py::test_logSoftmax",
                "./mtorch/tests/units/utils/persist/test_persist.py::test_tar",
                // "./mtorch/tests/cases/test_mlp.py",
                // "./mtorch/tests/smokes/test_package_import.py",
                // "./mtorch/tests/units/utils/data/transforms/",
                "-vv",
                "-s",
                "--rootdir=./mtorch/tests",
                "--md=./mtorch/tests/test_report.md",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
    ]
}